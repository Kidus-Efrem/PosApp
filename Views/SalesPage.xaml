<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:PosApp.ViewModels"
             xmlns:models="clr-namespace:PosApp.Models"
             x:Class="PosApp.Views.SalesPage"
             x:DataType="viewmodels:SalesViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto, *" Padding="20" RowSpacing="20">

        <!-- CUSTOM TOP NAVIGATION & TITLE BAR -->
        <Border Grid.Row="0" StrokeShape="RoundRectangle 12" Stroke="#E2E8F0" BackgroundColor="White" Padding="16">
            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Point of Sale" FontSize="22" FontAttributes="Bold" TextColor="#0F172A" />
                    <Label Text="Manage active catalog and process customer transactions" FontSize="12" TextColor="#64748B" />
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                    <Button Text="Point of Sale" Clicked="OnNavigateToSales" BackgroundColor="#059669" TextColor="White" FontSize="12" FontAttributes="Bold" CornerRadius="8" HeightRequest="38" Padding="14,0" />
                    <Button Text="Products" Clicked="OnNavigateToProducts" BackgroundColor="#F1F5F9" TextColor="#334155" FontSize="12" FontAttributes="Bold" CornerRadius="8" HeightRequest="38" Padding="14,0" />
                    <Button Text="History" Clicked="OnNavigateToHistory" BackgroundColor="#F1F5F9" TextColor="#334155" FontSize="12" FontAttributes="Bold" CornerRadius="8" HeightRequest="38" Padding="14,0" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- MAIN SCROLLVIEW CONTAINER -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">
            <Grid x:Name="ResponsiveLayout" ColumnSpacing="20" RowSpacing="20">

                <!-- LEFT COLUMN: Product Catalog Dashboard -->
                <Grid x:Name="CatalogContainer" Grid.Column="0" Grid.Row="0" RowDefinitions="Auto, Auto">

                    <VerticalStackLayout Grid.Row="0" Spacing="16" Margin="0,0,0,16">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Product Catalog" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" />
                            <Label Text="Select quantities and update items in the active cart" FontSize="13" TextColor="#64748B" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 8" Stroke="#CBD5E1" BackgroundColor="White" HeightRequest="40" Padding="0">
                                <SearchBar Text="{Binding SearchQuery, Mode=TwoWay}" BackgroundColor="Transparent" Placeholder="Search products..." PlaceholderColor="#94A3B8" TextColor="#0F172A" FontSize="13" VerticalTextAlignment="Center" CancelButtonColor="#64748B" />
                            </Border>

                            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                <Button Text="{Binding NameSortOption, StringFormat='Name: {0}'}" Command="{Binding ToggleNameSortCommand}" BackgroundColor="#F1F5F9" TextColor="#334155" FontAttributes="Bold" CornerRadius="8" HeightRequest="40" Padding="14,0" FontSize="12" />
                                <Button Text="{Binding PriceSortOption, StringFormat='Price: {0}'}" Command="{Binding TogglePriceSortCommand}" BackgroundColor="#F1F5F9" TextColor="#334155" FontAttributes="Bold" CornerRadius="8" HeightRequest="40" Padding="14,0" FontSize="12" />
                            </HorizontalStackLayout>
                        </Grid>

                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding FilterCategories}" Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Button Text="{Binding .}" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SalesViewModel}}, Path=FilterCategoryCommand}" CommandParameter="{Binding .}" BackgroundColor="#E2E8F0" TextColor="#334155" FontAttributes="Bold" CornerRadius="16" HeightRequest="32" Padding="16,0" FontSize="12" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>

                    <!-- Product Grid -->
                    <VerticalStackLayout Grid.Row="1" BindableLayout.ItemsSource="{Binding Products}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:Product">
                                <Border StrokeShape="RoundRectangle 12" Stroke="#E2E8F0" BackgroundColor="White" Padding="14">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15" TextColor="#1E293B" LineBreakMode="TailTruncation" />

                                        <HorizontalStackLayout Spacing="8">
                                            <Border StrokeShape="RoundRectangle 6" BackgroundColor="#F1F5F9" Padding="6,2" VerticalOptions="Center">
                                                <Label Text="{Binding Category}" FontSize="10" FontAttributes="Bold" TextColor="#475569" />
                                            </Border>
                                        </HorizontalStackLayout>

                                        <Grid ColumnDefinitions="*, Auto">
                                            <Label Text="{Binding Price, StringFormat='${0:F2}'}" TextColor="#059669" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="{Binding Stock, StringFormat='Stock: {0}'}" TextColor="#64748B" FontSize="11" VerticalOptions="Center" />
                                        </Grid>

                                        <BoxView HeightRequest="1" Color="#F1F5F9" Margin="0,2" />

                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="6">
                                            <Button Grid.Column="0" Text="-" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SalesViewModel}}, Path=DecreaseSelectedQtyCommand}" CommandParameter="{Binding .}" BackgroundColor="#F1F5F9" TextColor="#334155" FontSize="13" FontAttributes="Bold" HeightRequest="36" WidthRequest="36" CornerRadius="8" Padding="0" />
                                            <Border Grid.Column="1" StrokeShape="RoundRectangle 8" Stroke="#CBD5E1" BackgroundColor="#F8FAFC" HeightRequest="36" Padding="0">
                                                <Entry Text="{Binding SelectedQuantity, Mode=TwoWay}" Keyboard="Numeric" BackgroundColor="Transparent" TextColor="#0F172A" FontSize="13" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                            </Border>
                                            <Button Grid.Column="2" Text="+" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SalesViewModel}}, Path=IncreaseSelectedQtyCommand}" CommandParameter="{Binding .}" BackgroundColor="#F1F5F9" TextColor="#334155" FontSize="13" FontAttributes="Bold" HeightRequest="36" WidthRequest="36" CornerRadius="8" Padding="0" />
                                            <Button Grid.Column="3" Text="Set" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SalesViewModel}}, Path=SetCartQuantityCommand}" CommandParameter="{Binding .}" BackgroundColor="#059669" TextColor="White" FontSize="12" FontAttributes="Bold" HeightRequest="36" CornerRadius="8" Padding="12,0" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Grid>

                <!-- RIGHT COLUMN: Modern SaaS Cart Panel -->
                <Border x:Name="CartContainer" Grid.Column="1" Grid.Row="0" StrokeShape="RoundRectangle 16" Stroke="#E2E8F0" BackgroundColor="White" Padding="20" VerticalOptions="Start" Margin="0,0,0,20">
                    <Grid RowDefinitions="Auto, *, Auto, Auto, Auto, Auto" RowSpacing="16">

                        <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                            <Label Text="Current Order" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding CartItems.Count, StringFormat='{0} items'}" FontSize="13" TextColor="#64748B" VerticalOptions="Center" />
                        </Grid>

                        <CollectionView Grid.Row="1" ItemsSource="{Binding CartItems}" SelectionMode="None" HeightRequest="200">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:SalesItem">
                                    <Grid ColumnDefinitions="*, Auto, Auto" Padding="0,8" ColumnSpacing="12" VerticalOptions="Center">
                                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="14" TextColor="#1E293B" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Price, StringFormat='${0:F2} each'}" FontSize="12" TextColor="#64748B" />
                                        </VerticalStackLayout>

                                        <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" VerticalOptions="Center" FontSize="14" FontAttributes="Bold" TextColor="#059669" />

                                        <Button Grid.Column="2" Text="✕" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SalesViewModel}}, Path=RemoveFromCartCommand}" CommandParameter="{Binding .}" BackgroundColor="#FEF2F2" TextColor="#EF4444" FontSize="12" FontAttributes="Bold" HeightRequest="32" WidthRequest="32" CornerRadius="8" Padding="0" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- PROMO CODE SECTION -->
                        <VerticalStackLayout Grid.Row="2" Spacing="8">
                            <Label Text="Promo Code" FontSize="13" FontAttributes="Bold" TextColor="#64748B" />

                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8" IsVisible="{Binding ShowPromoInput}">
                                <Border Grid.Column="0" StrokeShape="RoundRectangle 8" Stroke="#CBD5E1" BackgroundColor="#F8FAFC" HeightRequest="40" Padding="0">
                                    <Entry Text="{Binding PromoCodeInput}" BackgroundColor="Transparent" Placeholder="SAVE10 or FLAT5" TextColor="#0F172A" PlaceholderColor="#94A3B8" FontSize="12" VerticalTextAlignment="Center" Margin="8,0" />
                                </Border>
                                <Button Grid.Column="1" Text="Apply" Command="{Binding ApplyPromoCommand}" BackgroundColor="#334155" TextColor="White" FontSize="12" FontAttributes="Bold" HeightRequest="40" CornerRadius="8" Padding="12,0" />
                            </Grid>

                            <Border StrokeShape="RoundRectangle 8" BackgroundColor="#ECFDF5" Stroke="#10B981" Padding="10,6" IsVisible="{Binding HasPromoApplied}">
                                <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                    <Label Text="{Binding AppliedPromoName}" TextColor="#065F46" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Text="Remove" Command="{Binding RemovePromoCommand}" BackgroundColor="Transparent" TextColor="#EF4444" FontSize="11" FontAttributes="Bold" HeightRequest="28" Padding="4,0" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- PAYMENT METHODS -->
                        <VerticalStackLayout Grid.Row="3" Spacing="8">
                            <Label Text="Payment Method" FontSize="13" FontAttributes="Bold" TextColor="#64748B" />
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">

                                <Button Grid.Column="0" Text="Cash" Command="{Binding SelectPaymentMethodCommand}" CommandParameter="Cash" FontAttributes="Bold" CornerRadius="8" HeightRequest="44">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsCashSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#0F172A" />
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsCashSelected}" Value="False">
                                            <Setter Property="BackgroundColor" Value="#F1F5F9" />
                                            <Setter Property="TextColor" Value="#64748B" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>

                                <Button Grid.Column="1" Text="Card" Command="{Binding SelectPaymentMethodCommand}" CommandParameter="Card" FontAttributes="Bold" CornerRadius="8" HeightRequest="44">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsCardSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#0F172A" />
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsCardSelected}" Value="False">
                                            <Setter Property="BackgroundColor" Value="#F1F5F9" />
                                            <Setter Property="TextColor" Value="#64748B" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- TOTAL BREAKDOWN -->
                        <VerticalStackLayout Grid.Row="4" Spacing="6">
                            <BoxView HeightRequest="1" Color="#E2E8F0" />

                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Subtotal" FontSize="13" TextColor="#64748B" />
                                <Label Grid.Column="1" Text="{Binding Subtotal, StringFormat='${0:F2}'}" FontSize="13" TextColor="#64748B" />
                            </Grid>

                            <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding HasPromoApplied}">
                                <Label Text="Discount" FontSize="13" TextColor="#10B981" />
                                <Label Grid.Column="1" Text="{Binding DiscountAmount, StringFormat='-${0:F2}'}" FontSize="13" TextColor="#10B981" />
                            </Grid>

                            <Grid ColumnDefinitions="*, Auto">
                                <Label Text="Sales Tax (8.5%)" FontSize="13" TextColor="#64748B" />
                                <Label Grid.Column="1" Text="{Binding TaxAmount, StringFormat='${0:F2}'}" FontSize="13" TextColor="#64748B" />
                            </Grid>

                            <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                                <Label Text="Total Due" FontSize="16" FontAttributes="Bold" TextColor="#334155" />
                                <Label Grid.Column="1" Text="{Binding GrandTotal, StringFormat='${0:F2}'}" FontSize="22" FontAttributes="Bold" TextColor="#059669" />
                            </Grid>
                        </VerticalStackLayout>

                        <Button Grid.Row="5" Text="Complete Checkout" 
                                BackgroundColor="#059669" TextColor="White"
                                FontAttributes="Bold" FontSize="15" HeightRequest="52" CornerRadius="10"
                                Command="{Binding CompleteCheckoutCommand}" />
                    </Grid>
                </Border>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
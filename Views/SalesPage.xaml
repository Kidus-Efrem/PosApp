<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:PosApp.ViewModels"
             xmlns:models="clr-namespace:PosApp.Models"
             x:Class="PosApp.Views.SalesPage"
             x:DataType="viewmodels:SalesViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto, *" Padding="20" RowSpacing="20">

        <!-- CUSTOM TOP NAVIGATION & TITLE BAR -->
        <Border Grid.Row="0" StrokeShape="RoundRectangle 12" Stroke="#E2E8F0" BackgroundColor="White" Padding="16">
            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                <!-- Page Title -->
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Point of Sale" FontSize="22" FontAttributes="Bold" TextColor="#0F172A" />
                    <Label Text="Manage active catalog and process customer transactions" FontSize="12" TextColor="#64748B" />
                </VerticalStackLayout>

                <!-- Custom In-App Navigation Tabs / Links -->
                <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                    <Button Text="Point of Sale" Clicked="OnNavigateToSales" BackgroundColor="#059669" TextColor="White" FontSize="12" FontAttributes="Bold" CornerRadius="8" HeightRequest="38" Padding="14,0" />
                    <Button Text="Products" Clicked="OnNavigateToProducts" BackgroundColor="#F1F5F9" TextColor="#334155" FontSize="12" FontAttributes="Bold" CornerRadius="8" HeightRequest="38" Padding="14,0" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="1" ColumnDefinitions="*, 400" ColumnSpacing="20">

            <!-- LEFT COLUMN: Product Catalog Dashboard -->
            <Grid Grid.Column="0" RowDefinitions="Auto, *">
                <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,16">
                    <Label Text="Product Catalog" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" />
                    <Label Text="Select quantities and update items in the active cart" FontSize="13" TextColor="#64748B" />
                </VerticalStackLayout>

                <CollectionView Grid.Row="1" ItemsSource="{Binding Products}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Product">
                            <Border StrokeShape="RoundRectangle 12" Stroke="#E2E8F0" BackgroundColor="White" Padding="14">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15" TextColor="#1E293B" LineBreakMode="TailTruncation" />
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="{Binding Price, StringFormat='${0:F2}'}" TextColor="#059669" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding Stock, StringFormat='Stock: {0}'}" TextColor="#64748B" FontSize="11" VerticalOptions="Center" />
                                    </Grid>

                                    <BoxView HeightRequest="1" Color="#F1F5F9" Margin="0,2" />

                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="6">
                                        <Button Grid.Column="0" Text="-" 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SalesViewModel}}, Path=DecreaseSelectedQtyCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#F1F5F9" TextColor="#334155" FontSize="13" FontAttributes="Bold" HeightRequest="36" WidthRequest="36" CornerRadius="8" Padding="0" />

                                        <Border Grid.Column="1" StrokeShape="RoundRectangle 8" Stroke="#CBD5E1" BackgroundColor="#F8FAFC" HeightRequest="36" Padding="0">
                                            <Entry Text="{Binding SelectedQuantity, Mode=TwoWay}" Keyboard="Numeric" TextColor="#0F172A" FontSize="13" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                        </Border>

                                        <Button Grid.Column="2" Text="+" 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SalesViewModel}}, Path=IncreaseSelectedQtyCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#F1F5F9" TextColor="#334155" FontSize="13" FontAttributes="Bold" HeightRequest="36" WidthRequest="36" CornerRadius="8" Padding="0" />

                                        <Button Grid.Column="3" Text="Set" 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SalesViewModel}}, Path=SetCartQuantityCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#059669" TextColor="White" FontSize="12" FontAttributes="Bold" HeightRequest="36" CornerRadius="8" Padding="12,0" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <!-- RIGHT COLUMN: Modern SaaS Cart Panel -->
            <Border Grid.Column="1" StrokeShape="RoundRectangle 16" Stroke="#E2E8F0" BackgroundColor="White" Padding="20">
                <Grid RowDefinitions="Auto, *, Auto, Auto" RowSpacing="16">
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                        <Label Text="Current Order" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding CartItems.Count, StringFormat='{0} items'}" FontSize="13" TextColor="#64748B" VerticalOptions="Center" />
                    </Grid>

                    <CollectionView Grid.Row="1" ItemsSource="{Binding CartItems}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:SalesItem">
                                <Grid ColumnDefinitions="*, Auto, Auto" Padding="0,8" ColumnSpacing="12" VerticalOptions="Center">
                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="14" TextColor="#1E293B" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Price, StringFormat='${0:F2} each'}" FontSize="12" TextColor="#64748B" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" VerticalOptions="Center" FontSize="14" FontAttributes="Bold" TextColor="#059669" />

                                    <Button Grid.Column="2" Text="✕" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SalesViewModel}}, Path=RemoveFromCartCommand}"
                                            CommandParameter="{Binding .}" 
                                            BackgroundColor="#FEF2F2" TextColor="#EF4444" FontSize="12" FontAttributes="Bold" HeightRequest="32" WidthRequest="32" CornerRadius="8" Padding="0" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <VerticalStackLayout Grid.Row="2" Spacing="10">
                        <BoxView HeightRequest="1" Color="#E2E8F0" />
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Total Due" FontSize="16" FontAttributes="Bold" TextColor="#334155" />
                            <Label Grid.Column="1" Text="{Binding GrandTotal, StringFormat='${0:F2}'}" FontSize="22" FontAttributes="Bold" TextColor="#059669" />
                        </Grid>
                    </VerticalStackLayout>

                    <Button Grid.Row="3" Text="Complete Checkout" 
                            BackgroundColor="#059669" TextColor="White"
                            FontAttributes="Bold" FontSize="15" HeightRequest="52" CornerRadius="10"
                            Command="{Binding CompleteCheckoutCommand}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
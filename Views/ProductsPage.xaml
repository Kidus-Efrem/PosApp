<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PosApp.ViewModels"
             x:Class="PosApp.Views.ProductsPage"
             Title="Point of Sale - Products">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20" RowSpacing="15">

        <!-- Input Form -->
        <VerticalStackLayout Grid.Row="0" Spacing="10">
            <Label Text="Manage Products" FontSize="18" FontAttributes="Bold" />
            <Entry Placeholder="Product Name" Text="{Binding ProductName}" />
            <Entry Placeholder="Price (e.g. 9.99)" Keyboard="Numeric" Text="{Binding ProductPrice, TargetNullValue=''}" />
            <Entry Placeholder="Stock Quantity (e.g. 50)" Keyboard="Numeric" Text="{Binding ProductStock, TargetNullValue=''}" />
            <Button Text="Add Product" Command="{Binding AddProductCommand}" BackgroundColor="Navy" TextColor="White" />
        </VerticalStackLayout>

        <!-- Product List -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Products}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <HorizontalStackLayout Padding="10" Spacing="15">
                        <Label Text="{Binding Name}" FontSize="16" WidthRequest="120" VerticalTextAlignment="Center" />
                        <Label Text="{Binding Price, StringFormat='${0:F2}'}" FontSize="16" WidthRequest="70" VerticalTextAlignment="Center" />
                        <Label Text="{Binding Stock, StringFormat='Stock: {0}'}" FontSize="14" WidthRequest="90" VerticalTextAlignment="Center" />
                        <Button Text="Delete" 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProductsViewModel}}, Path=DeleteProductCommand}" 
                                CommandParameter="{Binding .}" 
                                BackgroundColor="IndianRed" 
                                TextColor="White" />
                    </HorizontalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Load Data Trigger -->
        <Button Grid.Row="2" Text="Refresh List" Command="{Binding LoadProductsCommand}" />
    </Grid>
</ContentPage>
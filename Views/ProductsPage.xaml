<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:PosApp.ViewModels"
             xmlns:models="clr-namespace:PosApp.Models"
             x:Class="PosApp.Views.ProductsPage"
             x:DataType="viewmodels:ProductsViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <Grid RowDefinitions="Auto, *" Padding="20" RowSpacing="20">

        <!-- CUSTOM TOP NAVIGATION & TITLE BAR -->
        <Border Grid.Row="0" StrokeShape="RoundRectangle 12" Stroke="#E2E8F0" BackgroundColor="White" Padding="16">
            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Product Management" FontSize="22" FontAttributes="Bold" TextColor="#0F172A" />
                    <Label Text="Add, update, or remove inventory items from your catalog" FontSize="12" TextColor="#64748B" />
                </VerticalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                    <Button Text="Point of Sale" Clicked="OnNavigateToSales" BackgroundColor="#F1F5F9" TextColor="#334155" FontSize="12" FontAttributes="Bold" CornerRadius="8" HeightRequest="38" Padding="14,0" />
                    <Button Text="Products" Clicked="OnNavigateToProducts" BackgroundColor="#059669" TextColor="White" FontSize="12" FontAttributes="Bold" CornerRadius="8" HeightRequest="38" Padding="14,0" />
                    <Button Text="History" Clicked="OnNavigateToHistory" BackgroundColor="#F1F5F9" TextColor="#334155" FontSize="12" FontAttributes="Bold" CornerRadius="8" HeightRequest="38" Padding="14,0" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="1" ColumnDefinitions="380, *" ColumnSpacing="20">

            <!-- LEFT COLUMN: Add Product Form -->
            <Border Grid.Column="0" StrokeShape="RoundRectangle 16" Stroke="#E2E8F0" BackgroundColor="White" Padding="20" VerticalOptions="Start">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Add New Product" FontSize="18" FontAttributes="Bold" TextColor="#0F172A" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Product Name" FontSize="12" FontAttributes="Bold" TextColor="#64748B" />
                        <Border StrokeShape="RoundRectangle 8" Stroke="#CBD5E1" BackgroundColor="#F8FAFC" HeightRequest="40" Padding="0">
                            <Entry Text="{Binding Name}" Placeholder="e.g. Coffee" TextColor="#0F172A" PlaceholderColor="#94A3B8" FontSize="13" VerticalTextAlignment="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Price ($)" FontSize="12" FontAttributes="Bold" TextColor="#64748B" />
                        <Border StrokeShape="RoundRectangle 8" Stroke="#CBD5E1" BackgroundColor="#F8FAFC" HeightRequest="40" Padding="0">
                            <Entry Text="{Binding Price}" Keyboard="Numeric" Placeholder="0.00" TextColor="#0F172A" PlaceholderColor="#94A3B8" FontSize="13" VerticalTextAlignment="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Stock Quantity" FontSize="12" FontAttributes="Bold" TextColor="#64748B" />
                        <Border StrokeShape="RoundRectangle 8" Stroke="#CBD5E1" BackgroundColor="#F8FAFC" HeightRequest="40" Padding="0">
                            <Entry Text="{Binding Stock}" Keyboard="Numeric" Placeholder="0" TextColor="#0F172A" PlaceholderColor="#94A3B8" FontSize="13" VerticalTextAlignment="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <Button Text="Save Product" 
                            Command="{Binding AddProductCommand}" 
                            BackgroundColor="#059669" 
                            TextColor="White" 
                            FontAttributes="Bold" 
                            FontSize="14"
                            HeightRequest="46" 
                            CornerRadius="8"
                            Margin="0,8,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- RIGHT COLUMN: Existing Catalog List -->
            <Grid Grid.Column="1" RowDefinitions="Auto, *">
                <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,0,0,12">
                    <Label Text="Existing Catalog" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" />
                    <Label Text="Manage active inventory items" FontSize="13" TextColor="#64748B" />
                </VerticalStackLayout>

                <CollectionView Grid.Row="1" ItemsSource="{Binding Products}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Product">
                            <Border StrokeShape="RoundRectangle 12" Stroke="#E2E8F0" BackgroundColor="White" Padding="14" Margin="0,0,0,10">
                                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="15" VerticalOptions="Center">
                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15" TextColor="#1E293B" />
                                        <Label Text="{Binding Stock, StringFormat='Stock available: {0}'}" FontSize="12" TextColor="#64748B" />
                                    </VerticalStackLayout>

                                    <Label Grid.Column="1" Text="{Binding Price, StringFormat='${0:F2}'}" TextColor="#059669" FontAttributes="Bold" FontSize="16" VerticalOptions="Center" Margin="0,0,10,0" />

                                    <Button Grid.Column="2" Text="✕" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProductsViewModel}}, Path=DeleteProductCommand}" 
                                            CommandParameter="{Binding .}" 
                                            BackgroundColor="#FEF2F2" TextColor="#EF4444" FontSize="12" FontAttributes="Bold" HeightRequest="36" WidthRequest="36" CornerRadius="8" Padding="0" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
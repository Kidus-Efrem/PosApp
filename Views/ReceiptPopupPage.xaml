<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PosApp.Models"
             x:Class="PosApp.Views.ReceiptPopupPage"
             BackgroundColor="#80000000">
    <!-- Semi-transparent backdrop -->

    <Grid Padding="24" VerticalOptions="Center" HorizontalOptions="Center">
        <Border StrokeShape="RoundRectangle 16" 
                BackgroundColor="White" 
                HorizontalOptions="Center" 
                VerticalOptions="Center" 
                MaximumWidthRequest="420"
                WidthRequest="380"
                Padding="24">

            <Grid RowDefinitions="Auto, *, Auto, Auto" RowSpacing="16">

                <!-- Header -->
                <VerticalStackLayout Grid.Row="0" Spacing="4" HorizontalOptions="Center">
                    <Label Text="PosApp Receipt" FontSize="20" FontAttributes="Bold" TextColor="#0F172A" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding OrderDate, StringFormat='Date: {0:g}'}" FontSize="12" TextColor="#64748B" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Items List with Flexible Height -->
                <CollectionView Grid.Row="1" ItemsSource="{Binding PurchasedItems}" MaximumHeightRequest="220" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:SalesItem">
                            <Grid ColumnDefinitions="*, Auto, Auto" Padding="0,6" ColumnSpacing="12">
                                <Label Text="{Binding Name}" FontSize="14" TextColor="#1E293B" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="1" Text="{Binding Quantity, StringFormat='x{0}'}" FontSize="14" TextColor="#64748B" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding TotalPrice, StringFormat='${0:F2}'}" FontSize="14" FontAttributes="Bold" TextColor="#059669" VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Totals Breakdown -->
                <VerticalStackLayout Grid.Row="2" Spacing="8">
                    <BoxView HeightRequest="1" Color="#E2E8F0" />

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Subtotal" FontSize="13" TextColor="#64748B" />
                        <Label Grid.Column="1" Text="{Binding ReceiptSubtotal, StringFormat='${0:F2}'}" FontSize="13" TextColor="#64748B" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Sales Tax (8.5%)" FontSize="13" TextColor="#64748B" />
                        <Label Grid.Column="1" Text="{Binding ReceiptTax, StringFormat='${0:F2}'}" FontSize="13" TextColor="#64748B" />
                    </Grid>

                    <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                        <Label Text="Total Paid" FontSize="16" FontAttributes="Bold" TextColor="#334155" />
                        <Label Grid.Column="1" Text="{Binding GrandTotal, StringFormat='${0:F2}'}" FontSize="20" FontAttributes="Bold" TextColor="#059669" />
                    </Grid>
                </VerticalStackLayout>

                <!-- Actions -->
                <Grid Grid.Row="3" ColumnDefinitions="*, *" ColumnSpacing="12">
                    <Button Grid.Column="0" Text="Close" Clicked="OnCloseClicked" BackgroundColor="#F1F5F9" TextColor="#334155" FontAttributes="Bold" HeightRequest="44" CornerRadius="8" />
                    <Button Grid.Column="1" Text="Export PDF" Clicked="OnExportPdfClicked" BackgroundColor="#059669" TextColor="White" FontAttributes="Bold" HeightRequest="44" CornerRadius="8" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
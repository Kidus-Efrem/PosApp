<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PosApp.Views"
    x:Class="PosApp.AppShell"
    BackgroundColor="White"
    FlyoutBehavior="Disabled">

    <ShellContent 
        Title="Point of Sale"
        ContentTemplate="{DataTemplate views:SalesPage}" 
        Route="SalesPage" />

    <ShellContent 
        Title="Products"
        ContentTemplate="{DataTemplate views:ProductsPage}" 
        Route="ProductsPage" />

    <ShellContent 
        Title="Sales History"
        ContentTemplate="{DataTemplate views:SalesHistoryPage}" 
        Route="SalesHistoryPage" />

</Shell>